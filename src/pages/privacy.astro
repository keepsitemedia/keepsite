---
import BaseLayout from '../layouts/BaseLayout.astro';
import privacy from '../data/privacy.json';
import site from '../data/site.json';

const updated = new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', dateStyle: 'long' }).format(new Date(`${privacy.updated}T00:00:00Z`));
---
<BaseLayout title={privacy.meta.title} description={privacy.meta.description}>
  <section class="section-tight">
    <div class="container">
      <h1>{privacy.heading}</h1>
      <p class="lead">{privacy.intro}</p>
      <p class="muted">Last updated {updated}.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container prose">
      {privacy.sections.map((s) => (
        <>
          <h2>{s.heading}</h2>
          {s.body.map((p) => <p>{p}</p>)}
        </>
      ))}
      <h2>Contact</h2>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .prose h2 { font-size: var(--step-2); margin-top: var(--space-4); }
  .prose h2:first-child { margin-top: 0; }
</style>
