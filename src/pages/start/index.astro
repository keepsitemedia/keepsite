---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Questionnaire from '../../components/Questionnaire.astro';
import site from '../../data/site.json';
import packages from '../../data/packages.json';
import definition from '../../data/questionnaires/intro.json';
---
<BaseLayout
  title="Start your site | Keepsite Media"
  description="Eight questions about your business. We turn your answers into four home page directions and set up a call."
>
  <section class="section">
    <div class="container narrow">
      <h1>Start your site</h1>
      <p class="lead">
        Eight questions, most of which you can answer off the top of your head.
        We turn your answers into four home page directions for your site, then reach out to set up a call.
      </p>
      <p class="required-note muted">Fields marked Required have to be filled in.</p>

      {/* Netlify keeps the form under its original name so the submission
          notification set up at launch keeps firing; the hidden `form` field
          inside names the questionnaire definition the answers belong to. */}
      <Questionnaire definition={definition} slug="" token="" netlifyForm="inquiry">
        <fieldset>
          <legend>Your package</legend>
          <label class="field">
            <span>Which package are you thinking about?</span>
            <select name="package">
              <option value="Not sure yet" selected>Not sure yet</option>
              {packages.tiers.map((tier) => <option value={tier.name}>{tier.name}</option>)}
            </select>
          </label>
        </fieldset>
        <input type="hidden" name="offer" value="" />
        <p class="reply-time muted">Your four directions usually take about a week.</p>
      </Questionnaire>

      <p class="fallback muted">
        Would you rather email? <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Preselects the tier when a package card links here with ?tier=, and
  // carries a partner offer through when a landing page links with ?offer=,
  // so the inquiry reaches the office already tagged.
  // Without JS the select simply stays on "Not sure yet".
  (function () {
    var params = new URLSearchParams(window.location.search);
    var offer = params.get('offer');
    var offerField = document.querySelector('input[name="offer"]');
    if (offer && /^[a-z]+$/.test(offer) && offerField) offerField.value = offer;
    var wanted = params.get('tier');
    if (!wanted) return;
    var select = document.querySelector('select[name="package"]');
    if (!select) return;
    for (var i = 0; i < select.options.length; i++) {
      var slug = select.options[i].value.toLowerCase().replace(/\s+/g, '-');
      if (slug === wanted.toLowerCase()) { select.selectedIndex = i; return; }
    }
  })();
</script>

<style>
  .required-note { font-size: var(--step--1); }
  .reply-time { margin-bottom: var(--space-2); font-size: var(--step--1); }
  .fallback { margin-top: var(--space-4); font-size: var(--step--1); }
</style>
