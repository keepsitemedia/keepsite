---
// Unlisted: nothing in the header, footer or site.json links here. The page
// stays in the sitemap so a search for Lockii websites can still find it;
// the Lockii rep shares the link directly.
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCta from '../components/ClosingCta.astro';
import packages from '../data/packages.json';
import lockii from '../data/lockii.json';
import { discountedPrice, freeMonths, offerSummary } from '../scripts/lockii-offer.mjs';

const { offer, hero } = lockii;
const summary = offerSummary(offer);
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const startHref = (tierId?: string) => `/start/?offer=lockii${tierId ? `&tier=${tierId}` : ''}`;

// Range is several businesses under one roof, not a rental fleet.
const tiers = packages.tiers
  .filter((tier) => ['presence', 'growth', 'agile'].includes(tier.id))
  .map((tier) => ({ ...tier, lockiiPrice: discountedPrice(tier.buildPrice, offer.discountPercent) }));

const terms = `${capitalize(summary)}, for sites booked by ${offer.bookBy} through this page or by mentioning Lockii. Lockii setup is included on every package.`;

// Six pages of a Lockii site, drawn small. Ink at low opacity for the
// page furniture; one stripe colour for the thing each page is for.
const pages: Record<string, string> = {
  widget: `
    <g class="ink"><rect x="18" y="34" width="84" height="8" rx="2"/></g>
    <g class="ink" stroke-width="1.5" fill="none">
      <rect x="18" y="52" width="16" height="14"/><rect x="40" y="52" width="16" height="14"/><rect x="62" y="52" width="16" height="14"/><rect x="84" y="52" width="16" height="14"/>
      <rect x="18" y="72" width="16" height="14"/><rect x="62" y="72" width="16" height="14"/><rect x="84" y="72" width="16" height="14"/>
      <rect x="18" y="92" width="16" height="14"/><rect x="40" y="92" width="16" height="14"/><rect x="62" y="92" width="16" height="14"/><rect x="84" y="92" width="16" height="14"/>
    </g>
    <rect x="40" y="72" width="16" height="14" fill="var(--color-slate)"/>
    <rect x="18" y="118" width="84" height="16" rx="3" fill="var(--color-brand)"/>`,
  pickup: `
    <g fill="var(--color-slate)"><circle cx="26" cy="46" r="8"/><circle cx="26" cy="82" r="8"/><circle cx="26" cy="118" r="8"/></g>
    <g class="ink" stroke-width="1.5"><line x1="26" y1="54" x2="26" y2="74"/><line x1="26" y1="90" x2="26" y2="110"/></g>
    <g class="ink">
      <rect x="42" y="40" width="58" height="6" rx="2"/><rect x="42" y="50" width="40" height="4" rx="2"/>
      <rect x="42" y="76" width="58" height="6" rx="2"/><rect x="42" y="86" width="46" height="4" rx="2"/>
      <rect x="42" y="112" width="58" height="6" rx="2"/><rect x="42" y="122" width="34" height="4" rx="2"/>
    </g>`,
  rules: `
    <g class="ink" stroke-width="1.5" fill="none"><rect x="18" y="40" width="12" height="12" rx="2"/><rect x="18" y="64" width="12" height="12" rx="2"/><rect x="18" y="88" width="12" height="12" rx="2"/><rect x="18" y="112" width="12" height="12" rx="2"/></g>
    <g fill="none" stroke="var(--color-slate)" stroke-width="2.5" stroke-linecap="round"><path d="M21 46l3 3 5-6"/><path d="M21 70l3 3 5-6"/><path d="M21 94l3 3 5-6"/></g>
    <g class="ink"><rect x="40" y="43" width="60" height="6" rx="2"/><rect x="40" y="67" width="48" height="6" rx="2"/><rect x="40" y="91" width="56" height="6" rx="2"/><rect x="40" y="115" width="44" height="6" rx="2"/></g>`,
  faq: `
    <g class="ink" stroke-width="1.5"><line x1="18" y1="56" x2="102" y2="56"/><line x1="18" y1="78" x2="102" y2="78"/><line x1="18" y1="100" x2="102" y2="100"/><line x1="18" y1="122" x2="102" y2="122"/></g>
    <g class="ink"><rect x="18" y="40" width="54" height="6" rx="2"/><rect x="18" y="62" width="62" height="6" rx="2"/><rect x="18" y="84" width="46" height="6" rx="2"/><rect x="18" y="106" width="58" height="6" rx="2"/></g>
    <g stroke="var(--color-slate)" stroke-width="2" stroke-linecap="round"><path d="M92 40v8M88 44h8"/><path d="M92 62v8M88 66h8"/><path d="M92 84v8M88 88h8"/><path d="M92 106v8M88 110h8"/></g>`,
  locations: `
    <rect x="18" y="36" width="84" height="66" rx="3" fill="var(--color-surface-alt)"/>
    <g class="ink" stroke-width="1.5"><path d="M18 60 C40 58 46 82 70 78 S94 60 102 64"/><path d="M50 36 v66"/></g>
    <path d="M60 52c-7 0-12 5-12 12 0 9 12 22 12 22s12-13 12-22c0-7-5-12-12-12z" fill="var(--color-brand)"/>
    <circle cx="60" cy="64" r="4" fill="#fff"/>
    <g class="ink"><rect x="18" y="112" width="60" height="6" rx="2"/><rect x="18" y="122" width="40" height="4" rx="2"/></g>`,
  profile: `
    <rect x="18" y="34" width="26" height="26" rx="3" fill="var(--color-slate)"/>
    <g class="ink"><rect x="50" y="36" width="52" height="7" rx="2"/><rect x="50" y="48" width="36" height="4" rx="2"/></g>
    <g fill="var(--color-mustard)">
      <path d="M24 72l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
      <path d="M42 72l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
      <path d="M60 72l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
      <path d="M78 72l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
      <path d="M96 72l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
    </g>
    <g class="ink"><rect x="18" y="100" width="84" height="5" rx="2"/><rect x="18" y="110" width="70" height="5" rx="2"/><rect x="18" y="120" width="78" height="5" rx="2"/></g>`,
};
---
<BaseLayout
  title={lockii.meta.title}
  description={`${lockii.meta.description} Lockii customers get ${summary}.`}
>

  <section class="section">
    <div class="container hero">
      <div>
        <p class="label">For Lockii customers</p>
        <h1>{hero.heading}</h1>
        <p class="lead">{hero.lead}</p>
        <p class="offer">Lockii customers get {summary}.</p>
        <p><a class="btn" href={startHref()}>{hero.ctaLabel}</a></p>
      </div>
      {hero.image.src ? (
        <img class="hero-art" src={hero.image.src} alt={hero.image.alt} width="1600" height="1200" loading="eager" />
      ) : (
        <!-- The subject, drawn: the booking page a Lockii site is built
             around, at phone scale. A photograph replaces it when one exists. -->
        <figure class="hero-art hero-phone" aria-hidden="true">
          <svg class="page phone-page" viewBox="0 0 120 150">
            <rect x="18" y="14" width="10" height="10" rx="2" class="ink" />
            <rect x="34" y="17" width="20" height="4" rx="2" class="ink" />
            <rect x="58" y="17" width="20" height="4" rx="2" class="ink" />
            <Fragment set:html={pages.widget} />
          </svg>
        </figure>
      )}
    </div>
  </section>

  <!-- The plain truth about an unstaffed rental: the page's one slate band. -->
  <section class="section section-slate">
    <div class="container why">
      <h2 class="statement">{lockii.why.heading}</h2>
      <div>
        <p class="why-lead">{lockii.why.lead}</p>
        <ol class="jobs">
          {lockii.why.jobs.map((job) => <li>{job}</li>)}
        </ol>
        <p class="why-close">{lockii.why.close}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{lockii.includes.heading}</h2>
      <ol class="pages">
        {lockii.includes.items.map((item) => (
          <li>
            <svg class="page" viewBox="0 0 120 150" aria-hidden="true">
              <rect x="18" y="14" width="10" height="10" rx="2" class="ink" />
              <rect x="34" y="17" width="20" height="4" rx="2" class="ink" />
              <rect x="58" y="17" width="20" height="4" rx="2" class="ink" />
              <Fragment set:html={pages[item.kind]} />
            </svg>
            <span>{item.label}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>{lockii.packages.heading}</h2>
      <p class="lead">{lockii.packages.intro}</p>
      <div class="tier-grid">
        {tiers.map((tier) => (
          <div class={`card tier tier-${tier.id}`}>
            <h3 class="tier-name">{tier.name}</h3>
            <p class="serif tier-line">{tier.line}</p>
            <p class="tier-sub muted">{lockii.packages.tiers[tier.id as keyof typeof lockii.packages.tiers] ?? tier.sub}</p>
            <div class="tier-cost">
              <p class="tier-was price muted">
                <span class="visually-hidden">Normally </span><s>{tier.buildPrice}</s>
              </p>
              <p class="tier-price price">
                <span class="visually-hidden">Lockii price </span>{tier.lockiiPrice}
                <span class="tier-price-note muted">one-time build</span>
              </p>
              <p class="tier-monthly">{capitalize(freeMonths(offer.freeMonths))}, then <span class="price">{tier.monthlyPrice}</span>/month</p>
            </div>
            <p class="tier-cta"><a class="btn" href={startHref(tier.id)}>Start with {tier.name}</a></p>
          </div>
        ))}
      </div>
      <p class="fine muted">{terms}</p>
      <p class="more"><a href="/packages/">{lockii.packages.moreLabel}</a></p>
    </div>
  </section>

  <ClosingCta
    heading={lockii.closing.heading}
    sub={lockii.closing.sub}
    ctaLabel={lockii.closing.ctaLabel}
    ctaHref={startHref()}
  />

</BaseLayout>

<style>
  .hero { display: grid; gap: var(--space-4); align-items: center; }
  .offer { font-size: var(--step-1); margin: 0 0 var(--space-3); }
  .hero-art { width: 100%; height: auto; border-radius: var(--radius); }
  /* A phone: the drawing's page inside a rounded ink frame. */
  .hero-phone {
    margin: 0 auto;
    width: min(100%, 300px);
    padding: 10px;
    border: 3px solid var(--color-ink);
    border-radius: 28px;
    background: var(--color-surface);
  }
  .phone-page { border-radius: 18px; }

  .why { display: grid; gap: var(--space-4); }
  .why-lead { font-size: var(--step-2); margin-bottom: var(--space-2); }
  .jobs { margin: 0 0 var(--space-3); padding-left: 1.25rem; display: grid; gap: var(--space-1); font-size: var(--step-1); max-width: var(--maxw-lead); }
  .why-close { font-size: var(--step-1); margin: 0; }

  /* The drawings carry the page, so they run three across and large. */
  .pages { list-style: none; padding: 0; margin: var(--space-4) 0 0; max-width: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4) var(--space-3); }
  .pages li { display: grid; align-content: start; gap: var(--space-2); line-height: 1.45; }
  .page { display: block; width: 100%; height: auto; border: 1px solid var(--color-border); border-radius: 4px; background: var(--color-surface); }
  /* :global because the drawings arrive through set:html and carry no scope attribute. */
  .page :global(.ink) { fill: var(--color-ink); opacity: 0.32; }
  .page :global(g.ink[stroke-width]) { fill: none; stroke: var(--color-ink); }

  .tier-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); margin-top: var(--space-4); }
  /* Same colour per tier as the packages page. */
  .tier { display: flex; flex-direction: column; border-top: 6px solid var(--color-ink); }
  .tier-presence { border-top-color: var(--color-slate); }
  .tier-growth { border-top-color: var(--color-mustard); }
  .tier-agile { border-top-color: var(--color-brand); }
  .tier-name { font-size: var(--step-2); margin-bottom: var(--space-0); }
  .tier-line { color: var(--color-brand); font-size: var(--step-1); margin-bottom: var(--space-2); }
  .tier-sub { font-size: var(--step--1); }
  .tier-cost { margin-top: auto; padding-top: var(--space-3); border-top: 1px solid var(--color-border); }
  .tier-was { margin: 0; font-size: var(--step-1); }
  .tier-price { font-size: var(--step-4); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em; margin: 0; }
  .tier-price-note { display: block; font-size: var(--step--1); font-weight: 400; letter-spacing: 0; }
  .tier-monthly { margin: var(--space-1) 0 0; }
  .tier-cta { margin: var(--space-3) 0 0; }
  .fine { font-size: var(--step--1); margin-top: var(--space-3); }
  .more { margin-top: var(--space-2); }

  @media (min-width: 900px) {
    .hero { grid-template-columns: 1.1fr 1fr; gap: var(--space-5); }
    .why { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-5); align-items: start; }
    .why .statement { margin-bottom: 0; }
  }
  @media (min-width: 720px) {
    .pages { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .tier-grid { grid-template-columns: 1fr; }
  }
</style>
