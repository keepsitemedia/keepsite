---
export const prerender = false;
import '../../styles/global.css';
import '../../styles/office.css';
import '@fontsource-variable/newsreader/opsz.css';
// office.css's body text is set in the sans family; OfficeLayout carries
// this import for every other office page, and this page has no layout to
// inherit it from.
import '@fontsource-variable/instrument-sans/wght.css';
import AgreementBody from '../../components/office/AgreementBody.astro';
import site from '../../data/site.json';
import { store } from '../../../netlify/functions/lib/office/store.mjs';
import { viewAgreement, signatureViews, templateFor, TemplateGone } from '../../../netlify/functions/lib/office/agreements.mjs';
import { fillBlocks } from '../../../netlify/functions/lib/office/agreement-templates.mjs';
import { TOKEN, clientIp, userAgentOf } from '../../../netlify/functions/lib/office/sign.mjs';

type View = { agreement: any; party: 'keepsite' | 'client' | null; state: 'sign' | 'signed' | 'declined' | 'expired' | 'voided' | 'invalid' };
const t = Astro.url.searchParams.get('t') ?? '';
// Same shape as viewAgreement's own 'invalid' response below: a malformed
// token never reaches findByToken, so the store sees only well-formed ones.
if (!TOKEN.test(t)) return new Response('This signing link is not valid.', { status: 404, headers: { 'Content-Type': 'text/plain' } });
const error = Astro.url.searchParams.get('error');
const s = store();
const ip = clientIp(Astro.request) ?? undefined;
const userAgent = userAgentOf(Astro.request) ?? undefined;
const view = (await viewAgreement({ token: t, ip, userAgent }, s)) as View;
if (view.state === 'invalid') return new Response('This signing link is not valid.', { status: 404, headers: { 'Content-Type': 'text/plain' } });
// A keepsite token also resolves through findByToken; only the client uses
// this public page, and signAgreement/declineAgreement already refuse the
// other party, so mirror that here rather than render their side.
if (view.party !== 'client') return new Response('This signing link is not valid.', { status: 404, headers: { 'Content-Type': 'text/plain' } });
if (view.state === 'expired') Astro.response.status = 410;
const a = view.agreement;
// Only the 'sign' state renders AgreementBody below, and it must render the
// version the record names: a docx re-generation can retire a template or
// change one under a live agreement. renderCurrent maps that same gap to a
// 410 on /sign/document; mirror it here rather than show the wrong text.
let blocks: any[] = [];
let signatures: Record<string, { src: string; signedAt: string } | undefined> = {};
if (view.state === 'sign') {
  let template;
  try {
    template = templateFor(a);
  } catch (e) {
    if (e instanceof TemplateGone) return new Response("this agreement's template has changed; void it and create a new one", { status: 410, headers: { 'Content-Type': 'text/plain' } });
    throw e;
  }
  blocks = fillBlocks(template, a.fields) as any[];
  // Signed parties show their drawn signature on screen, matching the PDF.
  signatures = (await signatureViews(a, s)) as Record<string, { src: string; signedAt: string } | undefined>;
}
const titles: Record<string, string> = { sign: `Sign: ${a.templateName}`, signed: 'Signed', declined: 'Declined', expired: 'Link expired', voided: 'Agreement withdrawn' };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{titles[view.state]} | {site.brand}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="office">
    <header class="office-header"><div class="container"><span class="brand">{site.brand}</span></div></header>
    <main id="main" tabindex="-1"><div class="container narrow">
      {view.state === 'expired' && <><h1>This link has expired</h1><p>Signing links last fourteen days. Reply to the email you received, or write to <a href={`mailto:${site.email}`}>{site.email}</a>, and we will send a fresh one.</p></>}
      {view.state === 'declined' && <><h1>Declined</h1><p>You declined this agreement. Nothing further will happen unless you get in touch: <a href={`mailto:${site.email}`}>{site.email}</a>.</p></>}
      {view.state === 'voided' && <><h1>This agreement was withdrawn</h1><p>Keepsite withdrew this version. If you were expecting to sign, write to <a href={`mailto:${site.email}`}>{site.email}</a>.</p></>}
      {view.state === 'signed' && (
        <>
          <h1>Thank you</h1>
          <p class="lead">Your signature is recorded{a.status === 'completed' ? ', and both parties have signed. The signed copy with its certificate of completion is on its way to your email.' : '.'}</p>
          <p><a class="btn" href={`/sign/document?t=${encodeURIComponent(t)}`}>Download the PDF</a></p>
        </>
      )}
      {view.state === 'sign' && (
        <>
          <h1>{a.templateName}</h1>
          <p class="lead">Read the agreement below, then sign at the bottom. <a href={`/sign/document?t=${encodeURIComponent(t)}`}>Download as PDF</a>.</p>
          {error && <p class="error">{error}</p>}
          <div class="scrollbox" id="agreement-text"><AgreementBody blocks={blocks} signatures={signatures} /></div>
          <p class="field-hint">Scroll to the end of the agreement to enable signing.</p>
          <form method="POST" action="/sign/api/submit">
            <input type="hidden" name="t" value={t} />
            <input type="hidden" name="signature" value="" />
            <h2>Sign</h2>
            <label class="field"><span><input type="checkbox" name="consentTerms" data-required-consent /> I have read this agreement and agree to its terms.</span></label>
            <label class="field"><span><input type="checkbox" name="consentEsign" data-required-consent /> I agree to sign this agreement electronically, and I understand the signed copy will be delivered by email.</span></label>
            <div class="pad" data-signature-pad data-target="signature" data-scroll-target="agreement-text">
              <canvas aria-label="Draw your signature with your mouse or finger"></canvas>
              <p><button type="button" class="btn-outline btn-small" data-clear>Clear</button></p>
            </div>
            <p><button type="submit" class="btn" disabled>Sign agreement</button></p>
          </form>
          <details>
            <summary>Decline instead</summary>
            <form method="POST" action="/sign/api/decline">
              <input type="hidden" name="t" value={t} />
              <label class="field"><span>Tell us why, if you like</span><input name="reason" maxlength="500" /></label>
              <p><button type="submit" class="btn-outline btn-small">Decline this agreement</button></p>
            </form>
          </details>
          <p class="muted">Signing as {a.signers[view.party!].name}. Your IP address and the time are recorded with your signature.</p>
        </>
      )}
    </div></main>
    <script src="../../scripts/signature-pad.js"></script>
  </body>
</html>
