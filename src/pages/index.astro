---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCta from '../components/ClosingCta.astro';
import WorkCard from '../components/WorkCard.astro';
import Checklist from '../components/Checklist.astro';
import { tierHref } from '../scripts/tiers.mjs';
import home from '../data/home.json';
import packages from '../data/packages.json';

const featuredWork = (await getCollection('work'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order || +b.data.launched - +a.data.launched)
  .slice(0, 3);
---
<BaseLayout title={home.meta.title} description={home.meta.description}>

  <!-- 1: hero -->
  <section class="section hero">
    <div class="container">
      <div class="hero-top">
        <div>
          <h1>{home.hero.headline}</h1>
          <p class="hero-sub">{home.hero.sub}</p>
          <p class="hero-ctas">
            <a class="btn" href={home.hero.primaryCta.href}>{home.hero.primaryCta.label}</a>
            <a class="btn btn-outline" href={home.hero.secondaryCta.href}>{home.hero.secondaryCta.label}</a>
          </p>
        </div>

        <!-- The sub line, drawn: an owner's week with everything still on
             it except the website. -->
        <Checklist caption={home.hero.list.heading} items={home.hero.list.items} />
      </div>

    </div>
  </section>

  <!-- 2: the problem, said out loud. The page's one slate band. -->
  <section class="section section-slate">
    <div class="container">
      <h2 class="statement">{home.problem.heading}</h2>
      <p class="lead problem-body">{home.problem.body}</p>
    </div>
  </section>

  <!-- 3: solution -->
  <section class="section">
    <div class="container">
      <h2>{home.solution.heading}</h2>
      <div class="grid grid-3 beats">
        {home.solution.beats.map((beat) => (
          <div class="beat">
            <h3>{beat.title}</h3>
            <p class="muted">{beat.body}</p>
          </div>
        ))}
      </div>
      <p class="serif pull-line">{home.solution.pullLine}</p>
    </div>
  </section>

  <!-- 4: packages -->
  <section class="section section-alt">
    <div class="container">
      <h2>{home.packages.heading}</h2>
      <div class="rule-row tier-lines">
        {packages.tiers.map((tier) => (
          <a class="tier-link" href={tierHref(tier.id)}>
            <h3>{tier.name}</h3>
            <p class="serif tier-line">{tier.line}</p>
          </a>
        ))}
      </div>
      <p class="tier-more"><a class="link-arrow" href={home.packages.linkHref}>{home.packages.linkLabel}</a></p>
    </div>
  </section>

  <!-- 6: work. Renders only once the collection has two featured entries. -->
  {featuredWork.length >= 2 && (
    <section class="section">
      <div class="container">
        <h2>{home.work.heading}</h2>
        <div class="grid grid-3 work-strip">
          {featuredWork.map((entry) => <WorkCard entry={entry} />)}
        </div>
        <p><a class="link-arrow" href={home.work.linkHref}>{home.work.linkLabel}</a></p>
      </div>
    </section>
  )}

  <!-- 7: closing -->
  <ClosingCta
    heading={home.closing.heading}
    sub={home.closing.sub}
    ctaLabel={home.closing.ctaLabel}
    ctaHref={home.closing.ctaHref}
  />

</BaseLayout>

<style>
  .hero h1 { max-width: 16ch; }
  .hero-sub { max-width: var(--maxw-lead); font-size: var(--step-2); color: var(--color-muted); }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }

  /* The list sits under the buttons on a phone and beside the headline
     from 900px, where the 16ch measure leaves the right half of the hero
     empty. Bottom-aligned so it lands level with the buttons. */
  .hero-top { display: grid; gap: var(--space-4); }
  @media (min-width: 900px) {
    .hero-top {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: end;
      column-gap: var(--space-5);
    }
    .hero-top :global(.checklist) { padding-bottom: 0.2rem; }
  }

  .problem-body { margin-top: var(--space-3); font-size: var(--step-2); max-width: var(--maxw-lead); }

  .beats { margin-top: var(--space-4); }
  .beat h3 { font-size: var(--step-1); margin-bottom: var(--space-1); }

  .pull-line {
    margin-top: var(--space-5);
    margin-bottom: 0;
    font-size: var(--step-3);
    color: var(--color-brand);
    max-width: none;
  }

  /* Rule-separated rows, not cards: the homepage names the four
     packages and their promise, and /packages/ does the comparing. Two
     by two, so no tier sits alone on a row. */
  .tier-lines { margin-top: var(--space-4); }
  @media (min-width: 720px) {
    .tier-lines { grid-template-columns: repeat(2, 1fr); column-gap: var(--space-5); }
  }
  /* The link speaks for all four tiers, so it stands clear of the last one. */
  .tier-more { margin-top: var(--space-4); }
  .tier-link { display: block; text-decoration: none; color: var(--color-ink); }
  .tier-link h3 { font-size: var(--step-2); margin-bottom: var(--space-0); transition: color 120ms ease; }
  .tier-link:hover h3 { color: var(--color-brand); }
  .tier-line { color: var(--color-brand); font-size: var(--step-1); margin: 0; }

  .work-strip { margin-top: var(--space-4); }

</style>
