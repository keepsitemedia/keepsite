---
export const prerender = false;
import OfficeLayout from '../../../layouts/OfficeLayout.astro';
import Mark from '../../../components/office/Mark.astro';
import { store } from '../../../../netlify/functions/lib/office/store.mjs';
import { loadPipelines, findPipeline, findStage } from '../../../../netlify/functions/lib/office/pipeline.mjs';
import { todayIn, formatYmd } from '../../../../netlify/functions/lib/office/dates.mjs';
import { waitsOnClient, relative } from '../../../../netlify/functions/lib/office/attention.mjs';

// store.mjs and pipeline.mjs have no type declarations, so astro check sees
// their returns as any; these narrow the two list() reads to what this page
// actually reads rather than casting the whole store to any.
type ClientRow = { slug: string; business: string; name: string; tier: string; pipeline: string; stage: string };
type TaskRow = { due: string; title: string; done: boolean; questionnaire: string | null; payment: string | null; agreement: string | null };

const s = store();
const pipelines = await loadPipelines(s);
const clients = ((await s.clients.list()) as ClientRow[]).sort((a, b) => a.business.localeCompare(b.business));
const today = todayIn();

// The next open task per client, one store read per client. Fine at fifty.
const next = new Map<string, TaskRow | null>();
for (const c of clients) {
  const open = ((await s.tasks.list(c.slug)) as TaskRow[]).filter((t) => !t.done).sort((a, b) => a.due.localeCompare(b.due));
  next.set(c.slug, open[0] ?? null);
}
const stageName = (c: ClientRow) => findStage(findPipeline(pipelines, c.pipeline), c.stage)?.name ?? c.stage;
---
<OfficeLayout title="Clients">
  <div class="page-head">
    <h1>Clients</h1>
    <span class="sub">{clients.length}</span>
    <div class="actions"><a class="btn" href="/office/clients/new/">New client</a></div>
  </div>
  {clients.length === 0 ? (
    <p class="empty">No clients yet.</p>
  ) : (
    <div class="table-scroll">
      <table>
        <thead><tr><th>Business</th><th>Contact</th><th>Tier</th><th>Stage</th><th>Next</th></tr></thead>
        <tbody>
          {clients.map((c) => {
            const t = next.get(c.slug);
            const who = t ? (waitsOnClient(t) ? 'client' : 'you') : null;
            return (
              <tr>
                <td><a href={`/office/clients/${c.slug}/`}>{c.business}</a></td>
                <td>{c.name}</td>
                <td>{c.tier || <span class="quiet">Not decided</span>}</td>
                <td><span class="chip">{stageName(c)}</span></td>
                <td>
                  {t ? (
                    <>
                      <Mark state={t.due < today ? 'late' : 'waiting'}>{t.title}</Mark>
                      <span class="meta">{formatYmd(t.due)}, {relative(t.due, today)} · on {who}</span>
                    </>
                  ) : <span class="quiet">Nothing open</span>}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</OfficeLayout>
