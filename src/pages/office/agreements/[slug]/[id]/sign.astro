---
export const prerender = false;
import OfficeLayout from '../../../../../layouts/OfficeLayout.astro';
import AgreementBody from '../../../../../components/office/AgreementBody.astro';
import { store, SLUG } from '../../../../../../netlify/functions/lib/office/store.mjs';
import { ID } from '../../../../../../netlify/functions/lib/office/ids.mjs';
import { fillBlocks } from '../../../../../../netlify/functions/lib/office/agreement-templates.mjs';
import { signatureViews, templateFor, TemplateGone } from '../../../../../../netlify/functions/lib/office/agreements.mjs';

type Agreement = { id: string; slug: string; template: string; templateName: string; status: string; fields: any };
const slug = Astro.params.slug ?? '';
const id = Astro.params.id ?? '';
if (!SLUG.test(slug) || !ID.test(id)) return new Response('not found', { status: 404 });
const s = store();
const a = (await s.agreements.get(slug, id)) as Agreement | null;
if (!a) return new Response('not found', { status: 404 });
let template;
try {
  template = templateFor(a);
} catch (e) {
  if (e instanceof TemplateGone) return new Response("this agreement's template has changed; void it and create a new one", { status: 410, headers: { 'Content-Type': 'text/plain' } });
  throw e;
}
const blocks = fillBlocks(template, a.fields) as any[];
// agreements.mjs has no .d.ts, so tsc infers signatureViews' return from its
// `const out = {}` body rather than treating it as any; cast to what
// AgreementBody actually expects, the way draftFields is cast in [slug].astro.
const signatures = (await signatureViews(a, s)) as Record<string, { src: string; signedAt: string } | undefined>;
const csrf = Astro.locals.csrf;
const error = Astro.url.searchParams.get('error');
---
<OfficeLayout title={`Sign: ${a.templateName}`}>
  <div class="toolbar">
    <h1>{a.templateName}</h1>
    <span class="badge">{a.status}</span>
    <a href={`/office/clients/${slug}/?tab=agreements`}>Back</a>
    <a class="btn-outline btn-small" href={`/office/agreements/${slug}/${id}/document`}>PDF</a>
  </div>
  {error && <p class="error">{error}</p>}
  {a.status !== 'draft' ? (
    <p class="muted">This agreement has already been sent. Void it and create a new one to change Schedule 1.</p>
  ) : (
    <p class="muted">Read it through, sign as Keepsite, and Send opens the agreement email with the client's signing link filled in.</p>
  )}
  <div class="scrollbox" id="agreement-text"><AgreementBody blocks={blocks} signatures={signatures} /></div>
  {a.status === 'draft' && (
    <form method="POST" action="/office/api/agreement">
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="slug" value={slug} />
      <input type="hidden" name="id" value={id} />
      <input type="hidden" name="op" value="send" />
      <input type="hidden" name="signature" value="" />
      <h2>Sign as Keepsite</h2>
      <div class="pad" data-signature-pad data-target="signature" data-scroll-target="agreement-text">
        <canvas aria-label="Draw your signature"></canvas>
        <p><button type="button" class="btn-outline btn-small" data-clear>Clear</button></p>
      </div>
      <p><button type="submit" class="btn" disabled>Sign and send</button></p>
    </form>
  )}
  <script src="../../../../../scripts/signature-pad.js"></script>
</OfficeLayout>
