---
export const prerender = false;
import OfficeLayout from '../../layouts/OfficeLayout.astro';
import TaskRow from '../../components/office/TaskRow.astro';
import MeetingRow from '../../components/office/MeetingRow.astro';
import StageRail from '../../components/office/StageRail.astro';
import Mark from '../../components/office/Mark.astro';
import { store } from '../../../netlify/functions/lib/office/store.mjs';
import { loadPipelines } from '../../../netlify/functions/lib/office/pipeline.mjs';
import { todayIn, addDays } from '../../../netlify/functions/lib/office/dates.mjs';
import { splitOpen } from '../../../netlify/functions/lib/office/attention.mjs';

// store.mjs, pipeline.mjs and attention.mjs have no type declarations, so
// astro check sees their returns as any; these narrow each read to what
// this page actually touches rather than casting the whole store to any.
type ClientRow = { slug: string; business: string; pipeline: string; stage: string };
type Task = { id: string; slug: string; due: string; time: string | null; done: boolean };
type Meeting = { id: string; slug: string; title: string; ymd: string; time: string; minutes: number; link: string; notes: string };
type Stage = { id: string; name: string };
type Pipeline = { id: string; name: string; stages: Stage[] };
type PaymentDoc = { id: string; slug: string; kind: string; amount: number; status: string; createdAt: string; url: string | null; failureReason: string | null };

const s = store();
const today = todayIn();
const tomorrow = addDays(today, 1);
const meetings = ((await s.meetings.listAll()) as Meeting[])
  .filter((m) => m.ymd === today || m.ymd === tomorrow)
  .sort((a, b) => `${a.ymd}${a.time}`.localeCompare(`${b.ymd}${b.time}`));
const pipelines = (await loadPipelines(s)) as Pipeline[];
const clients = (await s.clients.list()) as ClientRow[];
const names = new Map(clients.map((c) => [c.slug, c.business]));
const tasks = (await s.tasks.listAll()) as Task[];
const { onYou, later, waiting } = splitOpen(tasks, today) as { onYou: Task[]; later: number; waiting: Task[] };
const late = onYou.filter((t) => t.due < today).length;
const csrf = Astro.locals.csrf;
const stageNames = Object.fromEntries(pipelines.flatMap((p) => p.stages.map((st) => [st.id, st.name])));
const boards = pipelines
  .map((p) => ({
    pipeline: p,
    clientsByStage: Object.fromEntries(p.stages.map((st) => [st.id, clients.filter((c) => c.pipeline === p.id && c.stage === st.id)])),
  }))
  .filter((b) => clients.some((c) => c.pipeline === b.pipeline.id));
const weekAgo = addDays(today, -7);
const allPayments = (await s.payments.listAll()) as PaymentDoc[];
const stalePending = allPayments.filter((p) => p.status === 'pending' && todayIn(undefined, new Date(p.createdAt)) <= weekAgo);
const failedPayments = allPayments.filter((p) => p.status === 'failed');
const dollars = (cents: number) => (cents / 100).toFixed(2);
const dayLabel = new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', weekday: 'long', month: 'long', day: 'numeric' }).format(new Date(`${today}T00:00:00Z`));
const meetingsToday = meetings.filter((m) => m.ymd === today).length;
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const summary = [
  `${onYou.length} on you${late ? `, ${late} late` : ''}`,
  `${waiting.length} waiting on clients`,
  meetingsToday ? `${plural(meetingsToday, 'meeting')} today` : '',
].filter(Boolean).join(' · ');
---
<OfficeLayout title="Today">
  <div class="page-head">
    <h1 class="file-name">{dayLabel}</h1>
    {clients.length > 0 && <span class="sub">{summary}</span>}
  </div>
  {clients.length === 0 && <p class="empty">No clients yet. <a href="/office/clients/new/">Add the first one.</a></p>}

  {boards.map((b) => (
    <>
      {boards.length > 1 && <h2>{b.pipeline.name}</h2>}
      <StageRail stages={b.pipeline.stages} clientsByStage={b.clientsByStage} label={b.pipeline.name} />
    </>
  ))}

  {clients.length > 0 && (
    <>
      <h2>On you <span class="count">{onYou.length}</span></h2>
      {onYou.length === 0
        ? <p class="empty">Nothing due in the next three days.{later > 0 && <> {later} more after that, <a href="/office/calendar/">on the calendar</a>.</>}</p>
        : <ul class="ledger">{onYou.map((t) => <TaskRow task={t} csrf={csrf} today={today} back="/office/" showClient business={names.get(t.slug)} stageNames={stageNames} />)}</ul>}
      {onYou.length > 0 && later > 0 && <p class="quiet">{later} more after that, <a href="/office/calendar/">on the calendar</a>.</p>}

      <h2>Waiting on clients <span class="count">{waiting.length}</span></h2>
      {waiting.length === 0
        ? <p class="empty">Nobody owes you anything right now.</p>
        : <ul class="ledger">{waiting.map((t) => <TaskRow task={t} csrf={csrf} today={today} back="/office/" showClient business={names.get(t.slug)} stageNames={stageNames} />)}</ul>}

      <h2>Meetings <span class="count">today and tomorrow</span></h2>
      {meetings.length === 0
        ? <p class="empty">None booked.</p>
        : <ul class="ledger">{meetings.map((m) => <MeetingRow meeting={m} csrf={csrf} back="/office/" showClient business={names.get(m.slug)} />)}</ul>}

      {(stalePending.length > 0 || failedPayments.length > 0) && (
        <>
          <h2>Money</h2>
          <ul class="ledger">
            {failedPayments.map((p) => (
              <li class="no-tick">
                <span class="when"><Mark state="late">Failed</Mark></span>
                <span class="what"><a class="client" href={`/office/clients/${p.slug}/?tab=payments`}>{names.get(p.slug) ?? p.slug}</a> {p.kind} ${dollars(p.amount)}<span class="meta"> · {p.failureReason}</span></span>
                <span class="act"><a href={`/office/clients/${p.slug}/?tab=payments`}>Payments</a></span>
              </li>
            ))}
            {stalePending.map((p) => (
              <li class="no-tick">
                <span class="when"><Mark state="waiting">Unpaid a week</Mark></span>
                <span class="what"><a class="client" href={`/office/clients/${p.slug}/?tab=payments`}>{names.get(p.slug) ?? p.slug}</a> {p.kind} ${dollars(p.amount)}</span>
                <span class="act">{p.url && <a href={p.url}>Checkout link</a>}</span>
              </li>
            ))}
          </ul>
        </>
      )}
    </>
  )}
</OfficeLayout>
