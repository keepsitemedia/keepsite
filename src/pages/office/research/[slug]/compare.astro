---
// One pair side by side: the Quick Compare block from the workbook, with
// the shared URLs and businesses lit so the counts can be checked by eye,
// and the read made here, where the evidence is.
export const prerender = false;
import OfficeLayout from '../../../../layouts/OfficeLayout.astro';
import { store, SLUG } from '../../../../../netlify/functions/lib/office/store.mjs';
import { comparePair, describePair, normalizeUrl, businessOf, pairKey, migrateStudy, openRound, pagesOf } from '../../../../../netlify/functions/lib/office/research.mjs';
import { formatYmd, todayIn } from '../../../../../netlify/functions/lib/office/dates.mjs';

const slug = Astro.params.slug ?? '';
if (!SLUG.test(slug)) return new Response('not found', { status: 404 });
const s = store();
const client = (await s.clients.get(slug)) as any;
const study = (await s.research.get(slug)) as any;
if (!client || !study) return new Response('not found', { status: 404 });
const round = openRound(migrateStudy(study));

const [aId, bId] = String(Astro.url.searchParams.get('pair') ?? '').split('|');
const a = round.keywords.find((k: any) => k.id === aId);
const b = round.keywords.find((k: any) => k.id === bId);
if (!a || !b || !round.serps[a.id] || !round.serps[b.id]) return new Response('not found', { status: 404 });

const serpA = round.serps[a.id];
const serpB = round.serps[b.id];
const c = comparePair(round, a.id, b.id) as any;
const total = Math.max(serpA.results.length, serpB.results.length);
const urls = new Set(c.sharedUrls as string[]);
const domains = new Set(c.sharedDomains as string[]);
// A row lights for the strongest match it has: the exact page, else the business.
const mark = (r: any) => (urls.has(normalizeUrl(r.url)) ? 'hl-url' : domains.has(businessOf(r.url)) ? 'hl-domain' : '');
// Every business that ranks on both sides gets a number, printed on each of
// its rows in both columns, so the pairing survives without the lines — on a
// narrow screen the columns stack and there is nothing to draw between.
const numbered = new Map<string, number>([...domains].sort().map((d, i) => [d, i + 1]));
const badge = (r: any) => numbered.get(businessOf(r.url)) ?? null;
const day = (iso: string) => formatYmd(todayIn(undefined, new Date(iso)));
const tab = `/office/clients/${slug}/?tab=research`;
const pages = pagesOf(round) as any[];
const pageOf = (id: string) => pages.find((p) => p.keywords.includes(id));
const pct = Math.round(c.similarity * 100);
const alike = c.band === 3 ? 'Share a page' : c.band === 0 ? 'Separate' : 'Close';
---
<OfficeLayout title={`${a.text} vs ${b.text}`}>
  <div class="page-head">
    <h1 class="file-name">{a.text} <span class="quiet">and</span> {b.text}</h1>
    <span class="sub">{client.business}</span>
    <span class="actions"><a class="btn-quiet btn-small" href={tab}>Back to research</a></span>
  </div>

  <dl class="glance">
    <div><dt>Alike</dt><dd>{pct}%<span class="detail">{alike}</span></dd></div>
    <div><dt>Businesses that decided it</dt><dd>{c.shared.length}<span class="detail">{c.shared.slice(0, 3).map((x: any) => x.business).join(', ') || 'none'}</span></dd></div>
    <div><dt>Directories in common</dt><dd>{c.sharedDirectories}<span class="detail">count for nothing</span></dd></div>
    <div><dt>Same exact URL</dt><dd>{c.exactUrl} of {total}</dd></div>
    <div><dt>Same business</dt><dd>{c.sameDomain} of {total}<span class="detail">{c.sameDomainDifferentPage} with a different page</span></dd></div>
    <div><dt>Pages</dt><dd>{pageOf(a.id)?.title ?? '—'}<span class="detail">{pageOf(a.id) === pageOf(b.id) ? 'both on this page' : `and ${pageOf(b.id)?.title ?? '—'}`}</span></dd></div>
  </dl>
  <p><strong>{describePair(c)}</strong></p>
  {c.shared.length > 0 && (
    <p class="quiet">Weight each shared business carried, heaviest first: {c.shared.map((x: any) => `${x.business} ${x.contribution.toFixed(2)}${x.sameUrl ? '' : ' (different page)'}`).join(' · ')}.</p>
  )}

  <h2>Results <span class="sub">top {total} for each search</span></h2>
  <p class="quiet legend"><span class="hl-url">Same exact URL</span> <span class="hl-domain">Same business, different page</span> <span class="legend-note">A number pairs one business across both columns; a solid line joins the same page, a dashed line the same business on a different page. Unmarked results appear in only one search.</span></p>
  <div class="serps" data-lines>
    <svg class="serp-lines" aria-hidden="true"></svg>
    {[{ k: a, serp: serpA }, { k: b, serp: serpB }].map(({ k, serp }) => (
      <section class="serp">
        <h3>{k.text}<span class="meta">captured {day(serp.capturedAt)}</span></h3>
        <ol class="serp-list">
          {serp.results.map((r: any) => (
            <li class={mark(r)} data-biz={badge(r) ? businessOf(r.url) : undefined} data-url={badge(r) ? normalizeUrl(r.url) : undefined}>
              <span class="rank">{r.rank}</span>
              <span class="res">
                <a href={r.url} target="_blank" rel="noopener">{r.title}</a>
                <span class="meta">{r.domain} · {r.pageType}{r.typeSource === 'manual' ? ' · edited' : ''}</span>
              </span>
              {badge(r) && <span class="biz-badge" title={`Business ${badge(r)}: ${businessOf(r.url)}`}>{badge(r)}</span>}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</OfficeLayout>

<script>
  // Connectors between the two columns, one per shared business: a row on
  // the left to every row on the right with the same business. Solid when the
  // two rows are the same page, dashed when the business ranks with a
  // different page for each search. Drawn from layout, so redrawn on resize;
  // hidden by CSS once the columns stack, where a line would have to go
  // through the text.
  const wrap = document.querySelector('[data-lines]');
  const svg = wrap?.querySelector('svg.serp-lines');
  const cols = wrap ? [...wrap.querySelectorAll('.serp')] : [];
  function draw() {
    if (!wrap || !svg || cols.length !== 2) return;
    const box = wrap.getBoundingClientRect();
    svg.setAttribute('width', String(box.width));
    svg.setAttribute('height', String(box.height));
    svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
    const left = [...cols[0].querySelectorAll<HTMLElement>('li[data-biz]')];
    const right = [...cols[1].querySelectorAll<HTMLElement>('li[data-biz]')];
    const paths = [];
    for (const a of left) {
      for (const b of right) {
        if (a.dataset.biz !== b.dataset.biz) continue;
        const ra = a.getBoundingClientRect();
        const rb = b.getBoundingClientRect();
        const x1 = ra.right - box.left; const y1 = ra.top + ra.height / 2 - box.top;
        const x2 = rb.left - box.left; const y2 = rb.top + rb.height / 2 - box.top;
        const mid = (x1 + x2) / 2;
        const same = a.dataset.url === b.dataset.url;
        paths.push(`<path d="M${x1},${y1} C${mid},${y1} ${mid},${y2} ${x2},${y2}" class="${same ? 'line-url' : 'line-biz'}"/>`);
      }
    }
    svg.innerHTML = paths.join('');
  }
  draw();
  if (wrap) new ResizeObserver(draw).observe(wrap);
  window.addEventListener('load', draw);
</script>
