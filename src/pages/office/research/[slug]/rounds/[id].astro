---
// A frozen round, read only: the page offers no controls at all, so there
// is nothing here that could post a change back to a round that is closed.
export const prerender = false;
import OfficeLayout from '../../../../../layouts/OfficeLayout.astro';
import Mark from '../../../../../components/office/Mark.astro';
import { store, SLUG } from '../../../../../../netlify/functions/lib/office/store.mjs';
import { migrateStudy, roundOf, pagesOf, studyView, confidenceWords } from '../../../../../../netlify/functions/lib/office/research.mjs';
import { formatYmd, todayIn } from '../../../../../../netlify/functions/lib/office/dates.mjs';
import StudyMatrix from '../../../../../components/office/StudyMatrix.astro';

const { slug, id } = Astro.params;
if (!SLUG.test(slug ?? '')) return new Response('not found', { status: 404 });
const client = await store().clients.get(slug);
const raw = await store().research.get(slug);
const study = raw ? migrateStudy(raw) : null;
const round = study ? roundOf(study, id) : null;
if (!client || !round) return new Response('Not found', { status: 404 });
const day = (iso: string) => formatYmd(todayIn(undefined, new Date(iso)));
const byId = new Map<string, any>(round.keywords.map((k: any) => [k.id, k]));
const text = (kid: string) => byId.get(kid)?.text ?? kid;
const captures = round.keywords.filter((k: any) => round.serps[k.id]);
const rows = pagesOf(round) as any[];
const titles = new Map<string, string>(rows.map((p: any) => [p.id, p.title]));
const view = studyView(round, rows) as any;
const compare = (key: string) => `/office/research/${slug}/compare/?pair=${encodeURIComponent(key)}&round=${encodeURIComponent(round.id)}`;
const reads = Object.entries(round.reads ?? {}) as [string, any][];
---
<OfficeLayout title={`${client.business} · research round`}>
  <div class="page-head">
    <h1>{client.business} — research</h1>
    <p class="quiet">Round started {day(round.startedAt)}{round.closedAt ? `, closed ${day(round.closedAt)}` : ''}. This round is frozen; <a href={`/office/clients/${slug}/?tab=research`}>the current round</a> is where changes go.</p>
  </div>
  {round.notes?.intro && <p>{round.notes.intro}</p>}
  <h2>Pages <span class="count">{rows.length}</span></h2>
  <ul class="ledger">
    {rows.map((p: any) => (
      <li class="no-tick">
        <span class="when"><Mark state={p.auto ? 'none' : 'done'}>{p.auto ? 'Automatic' : 'Edited'}</Mark></span>
        <span class="what"><span class="title">{p.title}</span><span class="meta"> · {p.kind ?? p.type ?? ''}{p.auto && p.confidence ? ` · ${confidenceWords(p, titles)}` : ''}</span>
          {p.keywords.length > 1 && <span class="meta line">{p.keywords.map(text).join(' · ')}</span>}
          {p.reason && <span class="meta line">{p.reason}</span>}
          {p.note && <span class="meta line">Note: {p.note}</span>}
        </span>
      </li>
    ))}
  </ul>
  <h2>Study</h2>
  <StudyMatrix view={view} compare={compare} />
  {view.order.length >= 2 && (
    <Fragment>
      <p class="quiet">Businesses the two searches have in common</p>
      <p class="quiet study-legend">
        <span><span class="swatch s0"></span>none</span>
        <span><span class="swatch s1"></span>a little</span>
        <span><span class="swatch s2"></span>enough to share a page</span>
        <span><span class="swatch s3"></span>nearly the same</span>
      </p>
      <p class="quiet">Green is two searches that bring up the same businesses; darker is more alike. Clay is a little overlap, not enough to share a page. Bands are pages, numbered in the margin; a boxed block is a page with more than one search.</p>
    </Fragment>
  )}
  {reads.length > 0 && (
    <>
      <h2>Decisions recorded <span class="count">{reads.length}</span></h2>
      <ul class="ledger">
        {reads.map(([key, read]) => (
          <li class="no-tick">
            <span class="when"><Mark state="done">{read.human}</Mark></span>
            <span class="what"><span class="title">{key.split('|').map(text).join(' · ')}</span><span class="meta"> · same cluster: {read.sameCluster}</span>
              {read.notes && <span class="meta line">Note: {read.notes}</span>}
            </span>
          </li>
        ))}
      </ul>
    </>
  )}
  <h2>Results</h2>
  {captures.map((k: any) => (
    <details class="fold">
      <summary>{k.text}<span class="sub">{day(round.serps[k.id].capturedAt)}</span></summary>
      <div class="fold-body"><div class="table-scroll"><table>
        <thead><tr><th>#</th><th>Result</th><th>Business</th><th>Type</th></tr></thead>
        <tbody>{round.serps[k.id].results.map((r: any) => (
          <tr><td class="num">{r.rank}</td><td><a href={r.url} target="_blank" rel="noopener">{r.title}</a></td><td class="quiet">{r.domain}</td><td>{r.pageType}</td></tr>
        ))}</tbody>
      </table></div></div>
    </details>
  ))}
  {round.notes?.closing && <p>{round.notes.closing}</p>}
  <p><a class="btn-quiet" href={`/office/research/${slug}/report/?round=${round.id}`} target="_blank" rel="noopener">This round's report</a></p>
</OfficeLayout>
