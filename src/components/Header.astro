---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import site from '../data/site.json';

const path = Astro.url.pathname;
// Match with or without a trailing slash so /packages and /packages/
// both mark the item current.
const isCurrent = (href: string) =>
  path === href || path.replace(/\/$/, '') === href.replace(/\/$/, '');

// The nav item appears the moment the collection has an entry, which
// is the same guard that generates the route. No code change needed
// to turn it on.
const hasWork = (await getCollection('work')).length > 0;
const navItems = hasWork
  ? [site.nav[0], { label: 'Work', href: '/work/', cta: false }, ...site.nav.slice(1)]
  : site.nav;
---
<header class="site-header">
  <div class="container header-inner">
    <Logo variant="compact" />
    <nav aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={item.cta ? 'nav-cta' : 'nav-link'}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  /* The header's bottom edge repeats the rule inside the lockup, the
     short one over the full-width one. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 3px solid var(--color-ink);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }
  nav { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .nav-link,
  .nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .nav-link { color: var(--color-ink); transition: color 120ms ease; }
  .nav-link:hover { color: var(--color-brand); }
  .nav-link[aria-current="page"] {
    color: var(--color-brand);
    text-decoration: underline;
    text-decoration-color: var(--color-brand);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }
  .nav-cta {
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius);
    background: var(--color-ink);
    color: #FFFFFF;
    transition: background-color 120ms ease;
  }
  .nav-cta:hover { background: var(--color-brand); color: #FFFFFF; }
</style>
