---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import site from '../data/site.json';

const path = Astro.url.pathname;
// Match with or without a trailing slash so /packages and /packages/
// both mark the item current.
const isCurrent = (href: string) =>
  path === href || path.replace(/\/$/, '') === href.replace(/\/$/, '');

// The nav item appears the moment the collection has an entry, which
// is the same guard that generates the route. No code change needed
// to turn it on.
const hasWork = (await getCollection('work')).length > 0;
const navItems = hasWork
  ? [site.nav[0], { label: 'Work', href: '/work/', cta: false }, ...site.nav.slice(1)]
  : site.nav;
const cta = navItems.find((item) => item.cta);
---
<header class="site-header">
  <div class="container header-inner">
    <Logo variant="compact" />

    <nav class="nav-wide" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={item.cta ? 'nav-cta' : 'nav-link'}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <!-- Phones and small tablets: one row, the links behind a toggle.
         A <details> needs no script, and verify.mjs counts every script
         tag on every page, so a menu button was never an option. The
         links are rendered twice; the copy that is display:none is out
         of the accessibility tree, so a reader meets one nav either way. -->
    {cta && <a class="nav-cta row-cta" href={cta.href}>{cta.label}</a>}
    <details class="menu">
      <summary>
        <span class="menu-word menu-open">Menu</span>
        <span class="menu-word menu-close">Close</span>
      </summary>
      <nav class="nav-narrow" aria-label="Primary">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={item.cta ? 'nav-cta panel-cta' : 'nav-link'}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >{item.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

<style>
  /* The header's bottom edge repeats the rule inside the lockup, the
     short one over the full-width one. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 3px solid var(--color-ink);
  }
  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 60px;
    padding-top: var(--space-1);
    padding-bottom: var(--space-1);
  }
  /* The logo takes the left, everything else packs right. */
  .header-inner > :global(.logo) { margin-right: auto; }

  .nav-link,
  .nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .nav-link { color: var(--color-ink); transition: color 120ms ease; }
  .nav-link:hover { color: var(--color-brand); }
  .nav-link[aria-current="page"] {
    color: var(--color-brand);
    text-decoration: underline;
    text-decoration-color: var(--color-brand);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }
  .nav-cta {
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius);
    background: var(--color-ink);
    color: #FFFFFF;
    transition: background-color 120ms ease;
  }
  .nav-cta:hover { background: var(--color-brand); color: #FFFFFF; }

  /* Wide: the links in the row, as before. */
  .nav-wide { display: flex; align-items: center; gap: var(--space-3); }
  .row-cta,
  .menu { display: none; }

  @media (max-width: 799px) {
    .nav-wide { display: none; }
    .menu { display: block; }

    .menu summary {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 var(--space-1);
      list-style: none;
      cursor: pointer;
      font-family: var(--font-label);
      font-weight: 700;
      font-size: 0.8125rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-ink);
    }
    .menu summary::-webkit-details-marker { display: none; }
    .menu summary:hover { color: var(--color-brand); }
    .menu-close,
    .menu[open] .menu-open { display: none; }
    .menu[open] .menu-close { display: inline; }

    /* The panel hangs below the row so the sticky header keeps its
       height and the page under it does not jump. It starts where the
       header's rule starts and carries its own copy of it, so the rule
       stays put whether the panel is open or shut. */
    .nav-narrow {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: grid;
      padding: var(--space-1) var(--space-3) var(--space-3);
      background: var(--color-bg);
      border-top: 3px solid var(--color-ink);
      border-bottom: 1px solid var(--color-border);
      box-shadow: 0 12px 24px -12px rgba(17, 17, 17, 0.25);
    }
    .nav-narrow .nav-link {
      min-height: 48px;
      border-bottom: 1px solid var(--color-border);
    }
    .nav-narrow .nav-link[aria-current="page"] { text-decoration: none; }
    .nav-narrow .panel-cta {
      justify-content: center;
      margin-top: var(--space-2);
    }
  }

  /* From 480px the call to action fits in the row beside the toggle, so
     the panel holds only the links. Below that it rides in the panel. */
  @media (min-width: 480px) and (max-width: 799px) {
    .row-cta { display: inline-flex; }
    .panel-cta { display: none; }
  }
  @media (max-width: 359px) {
    .header-inner > :global(.logo) { width: 8rem; }
  }
</style>
