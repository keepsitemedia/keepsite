---
// The logo is the brand artwork from docs/brand, cropped, recolored and
// written to public/brand by scripts/make-logos.mjs.
//
// It ships as <img> rather than inline SVG. The two lockups are 9 KB and
// 20 KB against a 13 KB home page, so inlining would put them into every
// document instead of letting the browser cache one copy for the site.
//
// Compact is the header: wordmark and rule. Full is the footer: the same
// lockup with the tagline under it. Both sit on light ground, so the art
// carries its own ink rather than inheriting the page's.
import site from '../data/site.json';

interface Props {
  variant?: 'compact' | 'full';
}
const { variant = 'compact' } = Astro.props;
---
{variant === 'compact' ? (
  <a class="logo logo-compact" href="/">
    <img src="/brand/lockup.svg" width="1213" height="316" alt={site.brand} decoding="async" />
  </a>
) : (
  <a class="logo logo-full" href="/">
    <img
      src="/brand/lockup-tagline.svg"
      width="1213"
      height="397"
      alt={`${site.brand}. ${site.tagline}`}
      loading="lazy"
      decoding="async"
    />
  </a>
)}

<style>
  .logo { display: block; }
  .logo img { display: block; width: 100%; height: auto; }

  /* Header: the wordmark's cap height lands near the nav's 13px label, so
     the two read as one bar rather than a logo with captions beside it. */
  .logo-compact { width: 9.5rem; }

  /* Footer: sized by width, so the lockup fills its grid column without
     outgrowing it on a narrow screen. */
  .logo-full { width: min(100%, 16rem); }
</style>
