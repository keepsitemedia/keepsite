---
// One component renders any definition in src/data/questionnaires/.
// Sections become real fieldset/legend and help text becomes aria-describedby
// because that structure is what a screen reader needs on a 39-question form —
// see src/data/questionnaires/build.json for the hardest case.
import site from '../data/site.json';
import shared from '../data/questionnaires/shared.json';

interface Question {
  key: string;
  label: string;
  help?: string;
  // A JSON import widens any literal union to string, so the three question
  // definitions this component reads (src/data/questionnaires/*.json) could
  // never satisfy a narrower type here without a cast at every call site.
  type: string;
  options?: string[];
  required?: boolean;
  // For short answers only: the input type and autocomplete token, so the
  // email question gets the browser's address check and autofill. A string
  // for the same JSON-widening reason as `type` above.
  input?: string;
  autocomplete?: string;
}

interface Props {
  definition: {
    formVersion: string;
    form: string;
    sections: Array<{
      legend: string;
      help?: string;
      // A site review walks a client through their own pages: the pages to
      // open for this section, and what to look for while reading them.
      links?: Array<{ label: string; href: string }>;
      prompts?: string[];
      // A long reference list, folded per heading so it never buries the
      // questions: the review's photo spots, page by page.
      list?: Array<{ heading: string; href?: string; items: string[] }>;
      // A line set before the section as a resting point in a long form.
      pause?: string;
      questions: Question[];
    }>;
  };
  slug: string;
  token: string;
  directions?: Array<{ number: number; id: string }>;
  // The Start page renders the intro for people who are not clients yet, so
  // it posts to Netlify Forms under this name instead of the token-checked
  // endpoint, and the slot carries the fields that are not intro questions.
  netlifyForm?: string;
}

const { definition, slug, token, directions = [], netlifyForm } = Astro.props;

const describedBy = (q: Question) => (q.help ? `${q.key}-help` : undefined);

const isGroup = (type: Question['type']) =>
  type === 'checkboxes' || type === 'openChecklist' || type === 'choice' || type === 'demoPick';

// Netlify Forms keeps one value per field name unless the name ends in [],
// so a multi-pick posted through it would arrive as its last tick. The hook
// (netlify/functions/lib/office/inquiry.mjs) strips the suffix again.
const multi = (type: Question['type']) => type === 'checkboxes' || type === 'openChecklist';
const fieldName = (q: Question) => (netlifyForm && multi(q.type) ? `${q.key}[]` : q.key);

const demoOptions = [
  ...directions.map((d) => ({ value: d.id, text: `Demo ${d.number}` })),
  { value: 'mix', text: 'A mix of several' },
];
---
<form
  method="POST"
  action={netlifyForm ? '/start/thanks/' : '/api/questionnaire'}
  enctype={netlifyForm ? undefined : 'multipart/form-data'}
  class="questionnaire"
  data-form={definition.form}
  data-slug={slug}
  name={netlifyForm}
  data-netlify={netlifyForm ? 'true' : undefined}
  data-netlify-honeypot={netlifyForm ? 'bot-field' : undefined}
>
  {netlifyForm && <input type="hidden" name="form-name" value={netlifyForm} />}
  <input type="hidden" name="form" value={definition.form} />
  <input type="hidden" name="formVersion" value={definition.formVersion} />
  {!netlifyForm && <input type="hidden" name="c" value={slug} />}
  {!netlifyForm && <input type="hidden" name="t" value={token} />}

  {!netlifyForm && <noscript>
    {/* The pages are static and one page serves every client, so ?c= and ?t=
        are read by the inline script; with it off the hidden fields ship empty
        and every submission is a 403. Better one sentence read up front than
        an hour of answers that cannot be sent. */}
    <p class="noscript-note">
      {shared.noscript} <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </noscript>}

  {/* Shown by the inline script when the link arrived without its ?t= code:
      the form stays usable so a saved draft is not lost, but the submission
      would be a 403, and that is better read now than after forty answers.
      Same box as the noscript note above, for the same reason. */}
  {!netlifyForm && <p class="noscript-note" data-missing-code hidden>
    This link is missing its access code, so your answers cannot be sent from
    here. Please open the link from your email instead, or write to us at{' '}
    <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>}

  <p class="hidden-field">
    <label>Don't fill this out: <input name="bot-field" /></label>
  </p>

  {definition.sections.map((s) => (
    <>
    {s.pause && <p class="pause"><strong>{s.pause}</strong></p>}
    <fieldset>
      <legend>{s.legend}</legend>
      {s.help && <p class="section-help">{s.help}</p>}
      {s.prompts && <ul class="section-prompts">{s.prompts.map((p) => <li>{p}</li>)}</ul>}
      {s.links && (
        <p class="section-links">
          {s.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}<span class="visually-hidden"> (opens in a new tab)</span></a>)}
        </p>
      )}
      {s.list && (
        <div class="section-list">
          {s.list.map((group) => (
            <details>
              <summary>{group.heading} <span class="count">{group.items.length}</span></summary>
              {group.href && <p><a href={group.href} target="_blank" rel="noopener">Open this page<span class="visually-hidden"> (opens in a new tab)</span></a></p>}
              <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
            </details>
          ))}
        </div>
      )}

      {s.questions.map((q) => (
        <div class="question">
          {isGroup(q.type) ? (
            <fieldset class="group" aria-describedby={describedBy(q)}>
              <legend class="group-legend">
                {q.label}
                {q.required && <span class="field-hint">Required</span>}
              </legend>
              {q.help && <p class="field-hint" id={`${q.key}-help`}>{q.help}</p>}

              {q.type === 'demoPick'
                ? demoOptions.map((o) => (
                    <label class="option">
                      <input type="radio" name={q.key} value={o.value} required={q.required} />
                      <span>{o.text}</span>
                    </label>
                  ))
                : (q.options ?? []).map((o) => (
                    <label class="option">
                      <input
                        type={q.type === 'choice' ? 'radio' : 'checkbox'}
                        name={fieldName(q)}
                        value={o}
                      />
                      <span>{o}</span>
                    </label>
                  ))}

              {q.type === 'openChecklist' && (
                <label class="option own">
                  <span>Something else</span>
                  <input type="text" name={`${q.key}__own`} autocomplete="off" />
                </label>
              )}
            </fieldset>
          ) : (
            // .field is the site-wide single-control label pattern
            // (src/styles/global.css); reusing it here keeps text inputs,
            // textareas and file inputs visually consistent with the rest
            // of the site without inventing new field styles.
            <label class="field">
              <span>
                {q.label}
                {q.required && <span class="field-hint">Required</span>}
              </span>
              {q.type === 'paragraph' && (
                <textarea name={q.key} rows={4} required={q.required} aria-describedby={describedBy(q)} />
              )}
              {q.type === 'short' && (
                <input type={(q.input ?? 'text') as astroHTML.JSX.HTMLInputTypeAttribute} name={q.key} required={q.required} autocomplete={q.autocomplete} aria-describedby={describedBy(q)} />
              )}
              {q.type === 'file' && (
                <input type="file" name={q.key} aria-describedby={describedBy(q)} />
              )}
              {q.help && <span class="field-hint" id={`${q.key}-help`}>{q.help}</span>}
            </label>
          )}
        </div>
      ))}
    </fieldset>
    </>
  ))}

  <slot />

  <button type="submit" class="btn">Send</button>
</form>
