---
// The whole study in one table. Its job is pages first, how many and which
// searches, and then how alike any two searches are: numbered page bands
// down the side, shades inside them. A pair reads the same either way
// round, so only the lower half is drawn. No script: it is a table, it
// scrolls, and every cell is a link to the two searches side by side.
import { band, pairKey } from '../../../netlify/functions/lib/office/research.mjs';

interface Props { view: { order: string[]; sims: Record<string, Record<string, number>>; blocks: string[][]; texts: Map<string, string> }; compare: (key: string) => string }
const { view, compare } = Astro.props;
const { order, sims, blocks, texts } = view;
// Which block each keyword sits in, so a cell knows whether it is inside a
// page and whether a page edge runs along it.
const blockOf = new Map<string, number>();
blocks.forEach((b, i) => b.forEach((id) => blockOf.set(id, i)));
const last = new Set(blocks.map((b) => b[b.length - 1]));
// The row that opens a page carries the page number for the whole band.
const opens = new Map(blocks.map((b, i) => [b[0], { no: i + 1, rows: b.length }]));
// A page of one search is already a band between two rules; only a page
// holding several needs its square outlined. The outline is drawn on the
// block's own edges rather than as an inset shadow, so it lines up with the
// page rules; only the lower half of the square is drawn, so the third side
// of the outline runs along the diagonal.
const multi = blocks.filter((b) => b.length >= 2);
const paired = new Set(multi.flat());
const opensBlock = new Set(multi.map((b) => b[0]));
const closesBlock = new Set(multi.map((b) => b[b.length - 1]));
const pct = (v: number) => `${Math.round(v * 100)}%`;
---
{order.length < 2 ? <p class="empty">Capture two keywords and the study grid appears here.</p> : (
  <div class="table-scroll">
    <table class="study">
      <thead>
        <tr><th class="corner"></th><th class="corner"></th>{order.map((id, j) => <th class="col" scope="col" title={texts.get(id)}><span><span class="idx">{j + 1}</span>{texts.get(id)}</span></th>)}</tr>
      </thead>
      <tbody>
        {order.map((a, i) => {
          const page = opens.get(a);
          return (
            <tr>
              {page && <th class="pageno" scope="rowgroup" rowspan={page.rows}>{page.no}</th>}
              <th class="row" scope="row"><span class="idx">{i + 1}</span>{texts.get(a)}</th>
              {order.map((b, j) => {
                if (j > i) return <td class="void"></td>;
                const same = blockOf.get(a) === blockOf.get(b);
                const inBlock = same && paired.has(a);
                const cls = ['cell', a === b ? 'diag' : `s${band(sims[a][b])}`,
                  inBlock && opensBlock.has(b) ? 'blk-left' : '', inBlock && closesBlock.has(a) ? 'blk-bottom' : '', inBlock && a === b ? 'blk-diag' : '',
                  last.has(b) ? 'edge-r' : '', last.has(a) ? 'edge-b' : ''].filter(Boolean).join(' ');
                const alike = `${texts.get(a)} · ${texts.get(b)}: ${pct(sims[a][b])} alike`;
                return a === b ? <td class={cls}></td>
                  : <td class={cls}><a href={compare(pairKey(a, b))} title={alike}><span class="sr-only">{alike}</span></a></td>;
              })}
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
)}
