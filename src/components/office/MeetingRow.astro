---
import { formatYmd, formatTime } from '../../../netlify/functions/lib/office/dates.mjs';
interface Props { meeting: any; csrf: string; back: string; showClient?: boolean; business?: string }
const { meeting: m, csrf, back, showClient = false, business = '' } = Astro.props;
---
<li class="no-tick">
  <span class="when">{formatYmd(m.ymd)}<small>{formatTime(m.time)} · {m.minutes} min</small></span>
  <span class="what">
    {showClient && <><a class="client" href={`/office/clients/${m.slug}/?tab=meetings`}>{business || m.slug}</a> </>}
    <span class="title">{m.title}</span>
    {m.notes && <span class="meta"> · {m.notes}</span>}
  </span>
  <span class="act">
    {m.link && <a href={m.link}>Join</a>}
    <details class="pop">
      <summary class="link-quiet">Move</summary>
      <form method="POST" action="/office/api/meeting" class="pop-sheet">
        <input type="hidden" name="csrf" value={csrf} />
        <input type="hidden" name="slug" value={m.slug} />
        <input type="hidden" name="id" value={m.id} />
        <input type="hidden" name="back" value={back} />
        <label class="field"><span>New date</span><input type="date" name="date" value={m.ymd} required /></label>
        <label class="field"><span>New time</span><input type="time" name="time" value={m.time} required /></label>
        <div class="pop-actions">
          <button class="btn btn-small" name="op" value="reschedule">Save and re-send</button>
          <button class="link-quiet danger" name="op" value="delete" formnovalidate onclick="return confirm('Cancel this meeting and email the client?')">Cancel meeting</button>
        </div>
      </form>
    </details>
  </span>
</li>
