---
// The Research tab: a glance of where the study stands, then capture,
// keywords, pairs, pages, results and the report as ledgers and folds.
// Editing sits behind pops so a row reads as a line; the read on a pair is
// made on the compare page, where the two result lists are.
import Mark from './Mark.astro';
import { bookmarklet, pairs, pageList, PAGE_TYPES, emptyStudy, migrateStudy, openRound, searchUrl, RESEARCH_SCHEME } from '../../../netlify/functions/lib/office/research.mjs';
import { formatYmd, todayIn } from '../../../netlify/functions/lib/office/dates.mjs';

interface Props { client: any; study: any; csrf: string; origin: string; captured: string }
const { client, csrf, origin, captured } = Astro.props;
const study = migrateStudy(Astro.props.study ?? emptyStudy(client.slug));
const round = openRound(study);
const closedRounds = study.rounds.slice(0, -1).reverse();
const slug: string = client.slug;
const api = '/office/api/research';
const byId = new Map<string, any>(round.keywords.map((k: any) => [k.id, k]));
const text = (id: string) => byId.get(id)?.text ?? id;
const captures = round.keywords.filter((k: any) => round.serps[k.id]);
const next = round.keywords.find((k: any) => !round.serps[k.id]);
const ps = pairs(round) as any[];
const gray = ps.filter((p) => p.signal === 'gray');
const undecided = gray.filter((p) => !p.read);
const strong = ps.filter((p) => p.signal === 'strong').length;
const low = ps.filter((p) => p.signal === 'low').length;
const pages = pageList(round) as any[];
const edited = pages.filter((p) => !p.auto).length;
const clusters = [...new Set(round.keywords.map((k: any) => k.cluster))] as string[];
const isRange = client.tier === 'Range';
const day = (iso: string) => formatYmd(todayIn(undefined, new Date(iso)));
const showPairs = Astro.url.searchParams.get('pairs') === '1';
const link = bookmarklet(origin);
const compare = (key: string) => `/office/research/${slug}/compare/?pair=${encodeURIComponent(key)}`;
const hidden = (fields: Record<string, string>) => Object.entries(fields).map(([name, value]) => ({ name, value }));

// The glance: four facts, each a mark, so the next thing to do reads first.
type Fact = { label: string; state: 'done' | 'waiting' | 'late' | 'none'; text: string; detail?: string; href?: string; search?: boolean };
const facts: Fact[] = [
  round.keywords.length === 0 ? { label: 'Captured', state: 'none', text: 'No keywords yet' }
    : next ? { label: 'Captured', state: captures.length ? 'waiting' : 'none', text: `${captures.length} of ${round.keywords.length}`, detail: `Next: ${next.text}`, href: searchUrl(next.text), search: true }
    : { label: 'Captured', state: 'done', text: `All ${round.keywords.length}` },
  ps.length === 0 ? { label: 'Pairs', state: 'none', text: 'Nothing to compare yet' }
    : undecided.length ? { label: 'Pairs', state: 'none', text: `${undecided.length} to decide`, detail: `Next: ${undecided[0].a.text} · ${undecided[0].b.text}`, href: compare(undecided[0].key) }
    : gray.length ? { label: 'Pairs', state: 'done', text: 'All decided', detail: `${gray.length} in the gray zone` }
    : { label: 'Pairs', state: 'done', text: 'None in the gray zone', detail: `${strong} agree, ${low} differ` },
  pages.length === 0 ? { label: 'Pages', state: 'none', text: 'None yet' }
    : { label: 'Pages', state: pages.some((p) => p.type === 'Tie / review') ? 'waiting' : 'done', text: `${pages.length} ${pages.length === 1 ? 'page' : 'pages'}`, detail: edited ? `${edited} edited by you` : 'Grouped automatically' },
  round.reportedAt ? { label: 'Report', state: 'done', text: `Written ${day(round.reportedAt)}`, href: `/office/clients/${slug}/?tab=documents` }
    : { label: 'Report', state: 'none', text: 'Not written' },
];
const external = (href: string) => href.startsWith('http');
---
<p class="quiet">Round {study.rounds.length}, started {day(round.startedAt)}.
  {closedRounds.length > 0 && <> Earlier: {closedRounds.map((r: any, i: number) => (
    <><a href={`/office/research/${slug}/rounds/${r.id}/`}>{day(r.startedAt)}</a>{i < closedRounds.length - 1 ? ', ' : ''}</>
  ))}.</>}
</p>
<details class="fold">
  <summary>Start a new round<span class="sub">Keeps this one, carries the keywords over</span></summary>
  <div class="fold-body">
    <p class="quiet">A new round freezes this one and starts again with the same keywords and service areas, so you can re-run the study in six or twelve months and still have what it said today.</p>
    <form method="POST" action={api} class="toolbar">
      {hidden({ csrf, slug, op: 'round', round: round.id }).map((h) => <input type="hidden" name={h.name} value={h.value} />)}
      <button class="btn-quiet" onclick="return confirm('Freeze this round and start a new one? This round stays readable but stops accepting changes.')">Start a new round</button>
    </form>
    {Object.keys(round.serps).length === 0 && study.rounds.length > 1 && (
      <form method="POST" action={api} class="toolbar">
        {hidden({ csrf, slug, op: 'round-discard', round: round.id }).map((h) => <input type="hidden" name={h.name} value={h.value} />)}
        <button class="link-quiet">This round is empty — go back to the previous one</button>
      </form>
    )}
  </div>
</details>
<dl class="glance">
  {facts.map((f) => (
    <div>
      <dt>{f.label}</dt>
      <dd>
        <Mark state={f.state}>{f.href && !f.detail ? <a href={f.href}>{f.text}</a> : f.text}</Mark>
        {f.detail && <span class="detail">{f.href ? <a href={f.href} data-search={f.search ? '' : undefined} target={external(f.href) ? '_blank' : undefined} rel={external(f.href) ? 'noopener' : undefined}>{f.detail}</a> : f.detail}</span>}
      </dd>
    </div>
  ))}
</dl>
{captured && byId.has(captured) && <p class="notice notice-ok">Captured “{text(captured)}”.</p>}

<details class="fold" open={captures.length === 0}>
  <summary>Capture<span class="sub">{next ? `Next: ${next.text}` : round.keywords.length ? 'Every keyword is captured' : 'Add keywords first'}</span></summary>
  <div class="fold-body">
    <p class="quiet">Drag this to your bookmarks bar once: <a class="btn-quiet btn-small" href={link} onclick="return false">Capture results</a>. It is the same button for every client: a capture is filed under the keyword whose text matches the search, and the capture page asks you to pick when none or several match.</p>
    <p class="quiet">For each keyword, open the search in the research profile and click the button on the results page.{next && <> Start with <a href={searchUrl(next.text)} data-search target="_blank" rel="noopener">{next.text}</a>.</>}</p>
    <p class="quiet"><label><input type="checkbox" id="research-search" /> Open searches in the research profile when I click Search.</label> Captures must be made signed in — signed out, Google hides the web addresses. The research profile is signed into an account with its activity paused, so the results are not shaped by your own searching. A page cannot pick a profile on its own, so this needs the handler installed: see <code>scripts/research-search/README.md</code>.</p>
  </div>
</details>

<script define:vars={{ scheme: RESEARCH_SCHEME }}>
  (function () {
    var KEY = 'ks.researchSearch';
    var box = document.getElementById('research-search');
    // Storage can throw in a locked-down profile; a throw reads as off, which
    // leaves the plain Google links working.
    var on = function () { try { return localStorage.getItem(KEY) === '1'; } catch (e) { return false; } };
    if (box) {
      box.checked = on();
      box.addEventListener('change', function () { try { localStorage.setItem(KEY, box.checked ? '1' : '0'); } catch (e) {} });
    }
    document.addEventListener('click', function (e) {
      if (e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var a = e.target.closest ? e.target.closest('a[data-search]') : null;
      if (!a || !on()) return;
      e.preventDefault();
      // The handler opens the research profile; this tab stays on the study.
      location.href = scheme + a.href;
    });
  })();
</script>

<h2>Keywords <span class="count">{round.keywords.length}</span></h2>
{round.keywords.length === 0 && (
  <form method="POST" action={api} class="inline">
    {hidden({ csrf, slug, op: 'draft', round: round.id }).map((h) => <input type="hidden" name={h.name} value={h.value} />)}
    <p class="empty">No keywords yet. <button class="btn-quiet btn-small">Draft from the build questionnaire</button> or add one below.</p>
  </form>
)}
{clusters.map((c) => (
  <details class="fold" open>
    <summary>{c}<span class="sub">{round.keywords.filter((k: any) => k.cluster === c).length}</span></summary>
    <div class="fold-body">
      <ul class="ledger">
        {round.keywords.filter((k: any) => k.cluster === c).map((k: any) => {
          const serp = round.serps[k.id];
          const related = (serp?.related ?? []).filter((r: string) => !round.keywords.some((x: any) => x.text.toLowerCase() === r.toLowerCase()));
          return (
            <li class="no-tick">
              <span class="when"><Mark state={serp ? 'done' : 'none'}>{serp ? day(serp.capturedAt) : 'Not captured'}</Mark></span>
              <span class="what">
                <span class="title">{k.text}</span>{isRange && k.arm && <span class="meta"> · {k.arm}</span>}
                {related.length > 0 && (
                  <span class="meta line">Related:
                    {related.map((r: string) => (
                      <form method="POST" action={api} class="inline">
                        {hidden({ csrf, slug, op: 'add', text: r, cluster: k.cluster, arm: k.arm ?? '', round: round.id }).map((h) => <input type="hidden" name={h.name} value={h.value} />)}
                        <button class="link-quiet">+ {r}</button>
                      </form>
                    ))}
                  </span>
                )}
              </span>
              <span class="act">
                <a href={searchUrl(k.text)} data-search target="_blank" rel="noopener">{serp ? 'Recapture' : 'Search'}</a>
                <details class="pop">
                  <summary class="link-quiet">Edit</summary>
                  <form method="POST" action={api} class="pop-sheet">
                    {hidden({ csrf, slug, id: k.id, round: round.id }).map((h) => <input type="hidden" name={h.name} value={h.value} />)}
                    <label class="field"><span>Keyword</span><input name="text" value={k.text} required /></label>
                    <label class="field"><span>Cluster</span><input name="cluster" value={k.cluster} list="clusters" /></label>
                    {isRange && <label class="field"><span>Arm</span><input name="arm" value={k.arm} /></label>}
                    <div class="pop-actions">
                      <button class="btn-quiet btn-small" name="op" value="edit">Save</button>
                      <button class="link-quiet danger" name="op" value="remove" formnovalidate onclick="return confirm('Remove this keyword and its results?')">Remove</button>
                    </div>
                  </form>
                </details>
              </span>
            </li>
          );
        })}
      </ul>
    </div>
  </details>
))}
<form method="POST" action={api} class="toolbar">
  {hidden({ csrf, slug, op: 'add', round: round.id }).map((h) => <input type="hidden" name={h.name} value={h.value} />)}
  <input class="grow" name="text" placeholder="New keyword" aria-label="New keyword" required />
  <input name="cluster" placeholder="Cluster" aria-label="Cluster" list="clusters" />
  <datalist id="clusters">{clusters.map((c) => <option value={c} />)}</datalist>
  {isRange && <input name="arm" placeholder="Arm" aria-label="Arm" />}
  <button class="btn-quiet">Add</button>
</form>
<details class="fold">
  <summary>Service areas<span class="sub">{round.areas.length ? round.areas.join(', ') : 'None set'}</span></summary>
  <div class="fold-body">
    <form method="POST" action={api} class="toolbar">
      {hidden({ csrf, slug, op: 'areas', round: round.id }).map((h) => <input type="hidden" name={h.name} value={h.value} />)}
      <label class="field grow"><span>Towns and areas, for spotting location pages</span><input name="areas" value={round.areas.join(', ')} /></label>
      <button class="btn-quiet">Save areas</button>
    </form>
  </div>
</details>

<h2>Pairs <span class="count">{showPairs ? ps.length : gray.length}</span></h2>
{ps.length === 0 && <p class="empty">Capture two keywords and their pair appears here.</p>}
{ps.length > 0 && (
  <p class="quiet">{strong} agree, {gray.length} in the gray zone, {low} differ. The counts and the suggestion are automatic; the read is yours, made on the compare page. <a href={`/office/clients/${slug}/?tab=research${showPairs ? '' : '&pairs=1'}`}>{showPairs ? 'Show the gray zone only.' : 'Show every pair.'}</a></p>
)}
{(showPairs ? ps : gray).length > 0 && (
  <ul class="ledger">
    {(showPairs ? ps : gray).map((p) => (
      <li class="no-tick">
        <span class="when">
          {p.read ? <Mark state="done">{p.read.human}</Mark>
            : p.signal === 'gray' ? <Mark state="none">Not decided</Mark>
            : <Mark state="waiting">{p.signal === 'strong' ? 'Agree' : 'Differ'}</Mark>}
        </span>
        <span class="what">
          <span class="title">{p.a.text} · {p.b.text}</span>
          <span class="meta line">{p.exactUrl} same URL · {p.sameDomainDifferentPage} same business · {p.samePageType} same type · suggested: {p.action}</span>
          {p.read?.notes && <span class="meta line">Note: {p.read.notes}</span>}
        </span>
        <span class="act"><a href={compare(p.key)}>Compare</a></span>
      </li>
    ))}
  </ul>
)}

<h2>Pages <span class="count">{pages.length}</span></h2>
{pages.length === 0 && <p class="empty">Capture a few keywords and the page list appears here.</p>}
{pages.length > 0 && <p class="quiet">Grouped from the pairs that agree and your same-cluster calls. Edit a page to keep your own title, type and note; “Tie / review” means the type is still yours to choose.</p>}
{pages.length > 0 && (
  <ul class="ledger">
    {pages.map((p) => (
      <li class="no-tick">
        <span class="when"><Mark state={p.type === 'Tie / review' ? 'waiting' : p.auto ? 'none' : 'done'}>{p.auto ? 'Automatic' : 'Edited'}</Mark></span>
        <span class="what">
          <span class="title">{p.title}</span><span class="meta"> · {p.type}{p.type === 'Tie / review' ? ', type to decide' : ''}</span>
          {/* The title is one of the keywords, so a single-keyword page would repeat itself. */}
          {p.keywords.length > 1 && <span class="meta line">{p.keywords.map(text).join(' · ')}</span>}
          {p.note && <span class="meta line">Note: {p.note}</span>}
        </span>
        <span class="act">
          <details class="pop">
            <summary class="link-quiet">Edit</summary>
            <form method="POST" action={api} class="pop-sheet">
              {hidden({ csrf, slug, id: p.id, keywords: p.keywords.join(','), round: round.id }).map((h) => <input type="hidden" name={h.name} value={h.value} />)}
              <label class="field"><span>Page</span><input name="title" value={p.title} required /></label>
              <label class="field"><span>Type</span><select name="type">{[...PAGE_TYPES, 'Tie / review'].map((t) => <option selected={p.type === t}>{t}</option>)}</select></label>
              <label class="field"><span>Note for the report</span><input name="note" value={p.note} /></label>
              <div class="pop-actions">
                <button class="btn-quiet btn-small" name="op" value="page">Save</button>
                {!p.auto && <button class="link-quiet" name="op" value="reset" formnovalidate>Back to automatic</button>}
              </div>
            </form>
          </details>
        </span>
      </li>
    ))}
  </ul>
)}

<h2>Results</h2>
{captures.length === 0 && <p class="empty">Each captured keyword's top eight appear here.</p>}
{captures.map((k: any) => (
  <details class="fold">
    <summary>{k.text}<span class="sub">{day(round.serps[k.id].capturedAt)}</span></summary>
    <div class="fold-body"><div class="table-scroll"><table>
      <thead><tr><th>#</th><th>Result</th><th>Business</th><th>Type</th></tr></thead>
      <tbody>
        {round.serps[k.id].results.map((r: any) => (
          <tr>
            <td class="num">{r.rank}</td>
            <td><a href={r.url} target="_blank" rel="noopener">{r.title}</a></td>
            <td class="quiet">{r.domain}</td>
            <td>
              <form method="POST" action={api} class="inline">
                {hidden({ csrf, slug, op: 'type', keyword: k.id, rank: String(r.rank), round: round.id }).map((h) => <input type="hidden" name={h.name} value={h.value} />)}
                <select name="pageType" aria-label="Page type" onchange="this.form.requestSubmit()">{PAGE_TYPES.map((t) => <option selected={r.pageType === t}>{t}</option>)}</select>
                {r.typeSource === 'manual' && <span class="quiet"> edited</span>}
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table></div></div>
  </details>
))}

<details class="fold" open={!!(round.notes?.intro || round.notes?.closing)}>
  <summary>Notes for the report<span class="sub">{round.notes?.intro || round.notes?.closing ? 'Written' : 'None yet'}</span></summary>
  <div class="fold-body">
    <p class="quiet">Your words around the automatic findings. The opening prints before them, the closing prints last. Leave either empty and it prints nothing.</p>
    <form method="POST" action={api} class="pop-sheet">
      {hidden({ csrf, slug, op: 'notes', round: round.id }).map((h) => <input type="hidden" name={h.name} value={h.value} />)}
      <label class="field"><span>Opening — what this study looked at and why</span><textarea name="intro" rows="4">{round.notes?.intro ?? ''}</textarea></label>
      <label class="field"><span>Closing — what you recommend</span><textarea name="closing" rows="4">{round.notes?.closing ?? ''}</textarea></label>
      <div class="pop-actions"><button class="btn-quiet btn-small">Save notes</button></div>
    </form>
  </div>
</details>

<h2>Report</h2>
<form method="POST" action={api} class="toolbar" id="report">
  {hidden({ csrf, slug, op: 'report', round: round.id }).map((h) => <input type="hidden" name={h.name} value={h.value} />)}
  <button class="btn" disabled={captures.length === 0}>Write the report to Documents</button>
  <a class="btn-quiet" href={`/office/research/${slug}/report/`} target="_blank" rel="noopener">Preview</a>
  {round.reportedAt && <span class="quiet">Last written {day(round.reportedAt)}. Send it from the <a href={`/office/clients/${slug}/?tab=emails`}>Emails tab</a>.</span>}
</form>
